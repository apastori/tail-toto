# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C source and header files
[*.{c,h}]
indent_style = space
indent_size = 4

# Makefiles (require tabs!)
[Makefile]
indent_style = tab

# Markdown files (don’t trim trailing whitespace for line breaks)
[*.md]
trim_trailing_whitespace = false

# JSON/YAML configs
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

